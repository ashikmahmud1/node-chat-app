STAGING_HOST=chat-staging.example.com
STAGING_TLS_DIR=/etc/nexus-staging/tls
STAGING_USER=tester
# Single-quote the bcrypt hash so Docker Compose treats dollar signs literally.
STAGING_PASSWORD_HASH=''
# Generate with openssl rand -hex 32.
STAGING_TURN_SECRET=
# Set to 127.0.0.1 for verification on the deployment machine.
STAGING_BIND_IP=0.0.0.0
# Change all three values together if this subnet overlaps a host route.
STAGING_MEDIA_SUBNET=10.253.42.0/24
STAGING_SFU_IP=10.253.42.10
STAGING_RELAY_IP=10.253.42.11
