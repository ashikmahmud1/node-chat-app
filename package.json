{
  "name": "node-chat-app",
  "version": "2.0.0",
  "description": "Real-time text, file, location, audio, and video chat application built with Node.js, Express, and Socket.IO",
  "main": "server/server.js",
  "scripts": {
    "prestart": "node server/utils/check-node-version.js",
    "start": "node --env-file-if-exists=.env server/server.js",
    "predev": "node server/utils/check-node-version.js",
    "dev": "nodemon --exec \"node --env-file-if-exists=.env\" server/server.js",
    "pretest": "node server/utils/check-node-version.js",
    "test": "mocha 'tests/**/*.test.js'",
    "test-watch": "nodemon --exec 'npm test'",
    "preimport:history": "node server/utils/check-node-version.js",
    "import:history": "node --env-file-if-exists=.env scripts/import-history.js"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "express": "^5.3.0",
    "jquery": "4.0.0",
    "multer": "^2.5.0",
    "multer-s3": "^3.0.1",
    "mustache": "4.2.0",
    "socket.io": "^4.8.4",
    "web-push": "^4.0.0",
    "werift": "^0.27.0"
  },
  "devDependencies": {
    "expect": "^30.5.2",
    "mocha": "^12.0.3",
    "nodemon": "^3.1.14",
    "socket.io-client": "4.8.4"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.7"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
