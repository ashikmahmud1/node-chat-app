PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Set to your HTTPS browser-facing origin in production, without a trailing slash.
PUBLIC_ORIGIN=
# Optional VAPID contact URL. Defaults to the HTTPS public origin.
PUSH_CONTACT=
# Enable only behind one trusted reverse proxy.
TRUST_PROXY=false
DATA_DIR=./data

MAX_ROOM_HISTORY=50
CHAT_RETENTION_DAYS=30
HTTP_RATE_LIMIT_MAX=120
SOCKET_RATE_LIMIT_MAX=40
MAX_CHAT_CONNECTIONS=500
MAX_SFU_PEERS=48

# Publish this UDP range to browsers and advertise a reachable IP for NAT/container deployments.
RTC_UDP_PORT=40000
RTC_UDP_PORT_END=40100
RTC_ADVERTISED_ADDRESS=
# Optional SFU IPv4 interface bind. In relay mode TURN must reach this interface.
RTC_BIND_ADDRESS=
RTC_ICE_TRANSPORT_POLICY=all
STUN_URL=
TURN_URL=
TURN_SECRET=

# Select one backend per installation.
STORAGE_TYPE=local
AWS_REGION=us-east-1
AWS_ENDPOINT_URL_S3=
AWS_FORCE_PATH_STYLE=false
AWS_S3_BUCKET_NAME=chat-app-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
